{
  "name": "omnirelief",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "@types/node": "^26.6.6",
      "varlock": "1.25.0",
      "@solar-icons/react": "^2.7.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "check:loc": "bun scripts/check-loc.ts",
    "setup": "bun install && cp -n apps/web/.env.example apps/web/.env; bun run env:generate",
    "db:push": "turbo run db:push -F @omnirelief/db --",
    "db:studio": "turbo run db:studio -F @omnirelief/db --",
    "db:generate": "turbo run db:generate -F @omnirelief/db --",
    "db:migrate": "turbo run db:migrate -F @omnirelief/db --",
    "deploy:setup": "bunx vercel link",
    "dev:vercel": "bunx vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "bunx vercel deploy",
    "deploy:prod": "bunx vercel deploy --prod",
    "deploy:check": "bunx vercel deploy --dry",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@omnirelief/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@2.0.1"
  },
  "packageManager": "bun@1.3.13"
}
